TELEGRAM_BOT_TOKEN=
TELEGRAM_MEDIA_SECRET=
TELEGRAM_PUBLIC_ORIGIN=https://lolzcloud.com
TELEGRAM_PORT=4388
TELEGRAM_STATE=/var/lib/lolzcloud-telegram
TELEGRAM_FFMPEG=/usr/bin/ffmpeg
TELEGRAM_CACHE_BYTES=2147483648
# Optional: dedicated private channel; bot must be an administrator with post permission.
TELEGRAM_CACHE_CHAT=
# Only enable after setting BotFather /setinlinefeedback to 100%.
# Cold results then have cover previews and automatically become audio when selected.
# Direct audio (0) works even when inline feedback is disabled.
TELEGRAM_INLINE_ARTICLES=0
