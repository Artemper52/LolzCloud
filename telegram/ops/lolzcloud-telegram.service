[Unit]
Description=LolzCloud Telegram inline music bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lolzcloud-telegram
Group=lolzcloud-telegram
WorkingDirectory=/opt/lolzcloud-telegram/current
ExecStart=/opt/lolzcloud-runtime/node telegram/index.cjs
Environment=NODE_ENV=production
EnvironmentFile=/etc/lolzcloud-telegram/credentials.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lolzcloud-telegram
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=48
CPUQuota=150%
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
