{
  "manifest_version": 3,
  "name": "LolzCloud В· РїРµСЂРµРЅРѕСЃ SoundCloud",
  "version": "1.2.0",
  "description": "Показывает ваш аккаунт SoundCloud для выбора и входа в LolzCloud без файла и повторного пароля.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/transfer/*/"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "РџРµСЂРµРЅРµСЃС‚Рё РІС…РѕРґ SoundCloud РІ LolzCloud"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "soundcloud-transfer@lolzcloud.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
