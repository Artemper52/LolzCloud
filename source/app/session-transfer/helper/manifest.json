{
  "manifest_version": 3,
  "name": "LolzCloud · перенос SoundCloud",
  "version": "1.0.0",
  "description": "Сохраняет ваш вход SoundCloud в локальный файл с паролем по вашему нажатию.",
  "permissions": ["cookies"],
  "host_permissions": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Перенести вход SoundCloud в LolzCloud" },
  "browser_specific_settings": { "gecko": { "id": "soundcloud-transfer@lolzcloud.com", "strict_min_version": "109.0", "data_collection_permissions": { "required": ["none"] } } }
}
